// Envelope powered by HealthProHub: database schema.
//
// Follows docs/05-data-model.md. Differences from the doc, and why:
//   - Tenant model: tenantId is a real foreign key (organisations, HealthProHub dual-mode).
//   - Session model: refresh-token rotation for sender logins (docs/10, "Session").
//   - User.role: owner/admin/member, so a tenant can have more than one sender.
//   - All ids are native Postgres uuid columns.
//   - AuditTrail foreign keys use RESTRICT instead of CASCADE / SET NULL. Postgres runs
//     referential actions as the table owner, so a cascade would let the app role delete
//     or rewrite audit rows it has no UPDATE/DELETE privilege on (docs/05, invariant 5).
//   - DocumentVersion records pageCount and sizeBytes; Envelope records the display
//     filename and page count (needed for the page-range check, invariant 3).
//
// Rules Prisma cannot express (CHECK constraints, the partial unique index, and the
// role grants) are hand-written at the end of the initial migration.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Compiled by tsc together with the app, so imports must name the emitted .js files.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
//  Enumerations
// ─────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum EnvelopeStatus {
  DRAFT
  SENT
  DELIVERED
  PARTIALLY_SIGNED
  /// The deadline passed with signatures missing. Paused, not finished: the
  /// sender can extend it or cancel it (ADR 0013).
  EXPIRED
  COMPLETED
  DECLINED
  VOIDED
}

enum RecipientRole {
  SIGNER // must sign
  APPROVER // must approve, does not sign
  VIEWER // read-only access
  CC // receives the completed copy only
}

enum RecipientStatus {
  PENDING
  SENT
  DELIVERED
  VIEWED
  SIGNED
  DECLINED
}

/// How an adopted signature or initials image was made (docs/00: "how they signed").
enum SignatureMethod {
  DRAWN
  TYPED
}

enum FieldType {
  SIGNATURE
  INITIALS
  DATE_SIGNED // system-generated, never user-editable
  TEXT_INPUT
  CHECKBOX
}

/// A delivery attempt's outcome (docs/08, "Webhooks"; docs/18).
enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED // will retry
  EXHAUSTED // every attempt spent
}

// ─────────────────────────────────────────────────────────────
//  Tenancy and accounts
// ─────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The tenant's default jurisdiction (docs/07). Overridable per envelope via
  /// Envelope.jurisdictionCode; resolution is frozen onto Envelope.policySnapshot
  /// at creation (ADR 0011).
  jurisdictionCode String @default("US")

  users            User[]
  envelopes        Envelope[]
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]
}

/// One row per (tenant, status), kept exact by a trigger on Envelope. Lets the
/// dashboard's tab counts read ~8 rows instead of aggregating every envelope
/// the tenant has ever had (100M-row scale follow-up, docs/16).
model TenantEnvelopeCount {
  tenantId String         @db.Uuid
  status   EnvelopeStatus
  count    Int            @default(0)

  @@id([tenantId, status])
}

/// Senders and admins only. Signers never have a User row.
model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @db.Uuid
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  email        String    @unique
  passwordHash String
  fullName     String
  organization String?
  role         UserRole  @default(OWNER)
  lastLoginAt  DateTime?

  /// A tenant's hidden API-key principal (docs/18), never a real person. Has
  /// an unusable random passwordHash, like an invited-but-not-yet-accepted
  /// user, and is filtered out of every human-facing user list.
  isServiceAccount Boolean @default(false)

  /// Set when an OWNER invites this person to the tenant (docs/17 step 6):
  /// only its HMAC is stored, like a signing token (ADR 0009). Null once
  /// accepted, or for a user who registered themselves rather than being
  /// invited. passwordHash is an unusable random value until accepted.
  inviteTokenHash      String?   @unique
  inviteTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  envelopes          Envelope[]        @relation("EnvelopeOwner")
  voidedEnvelopes    Envelope[]        @relation("EnvelopeVoidedBy")
  legalHoldEnvelopes Envelope[]        @relation("EnvelopeLegalHoldBy")
  sessions           Session[]
  apiKeysActing      ApiKey[]          @relation("ApiKeyActingUser")
  apiKeysCreated     ApiKey[]          @relation("ApiKeyCreatedBy")
  webhookEndpoints   WebhookEndpoint[]

  @@index([tenantId])
}

/// Server-to-server auth for a third-party integration (docs/08, "Server
/// integration"; docs/18). Every key acts as the tenant's one hidden
/// `isServiceAccount` User (`actingUserId`), so it reads and writes the whole
/// tenant, matching docs/08's "whole tenant" scope, without `ownership.ts`
/// needing any special case for a non-human caller.
model ApiKey {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  label String

  /// HMAC-SHA256 of the raw key (like Session.tokenHash, ADR 0009's pattern
  /// applied to a bearer credential rather than a link token). The raw value
  /// is shown once, at creation, and never stored.
  keyHash String @unique

  /// The raw key's first characters, so the tenant can tell keys apart in
  /// the UI and in logs without the hash revealing anything reversible.
  displayPrefix String

  /// SHOULD support read-only variants (docs/08). Enforced per route by
  /// `@ApiKeyAllowed({ write })`, not by sniffing the HTTP verb.
  readOnly Boolean @default(false)

  actingUserId String @db.Uuid
  actingUser   User   @relation("ApiKeyActingUser", fields: [actingUserId], references: [id], onDelete: Restrict)

  /// The human ADMIN/OWNER who issued it. Accountability only — never the
  /// source of the key's own permissions.
  createdByUserId String @db.Uuid
  createdByUser   User   @relation("ApiKeyCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
}

/// A tenant's registered webhook receiver (docs/08, "Webhooks"; docs/18).
model WebhookEndpoint {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  url         String
  description String?

  /// AES-256-GCM ciphertext of the signing secret. Unlike keyHash above, this
  /// must be reversible: every delivery recomputes
  /// HMAC_SHA256(secret, "{timestamp}.{body}") fresh (docs/08), so the raw
  /// secret has to come back, not just be verified against.
  secretCiphertext  String
  /// The raw secret's first characters, shown after creation instead of the
  /// full value, the same way displayPrefix works for an API key.
  secretDisplayHint String

  /// Empty means every event (docs/08's 9 types, minus envelope.delivered —
  /// see docs/18).
  subscribedEvents String[] @default([])
  isActive         Boolean  @default(true)

  createdByUserId String @db.Uuid
  createdByUser   User   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([tenantId])
}

/// One row per (endpoint, event) delivery attempt series (docs/08,
/// "Webhooks"). `payload` is replayed verbatim on redrive.
model WebhookDelivery {
  id                String          @id @default(uuid(7)) @db.Uuid
  /// Denormalised from the endpoint so the 7-day purge sweep and the tenant's
  /// own deliveries list never need a join.
  tenantId          String          @db.Uuid
  webhookEndpointId String          @db.Uuid
  webhookEndpoint   WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Restrict)

  /// Shared by every endpoint's delivery of the same occurrence, so a
  /// receiver's dedup-on-event.id logic is meaningful even with more than
  /// one endpoint registered.
  eventId   String
  eventType String
  payload   Json

  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  lastAttemptAt  DateTime?
  nextAttemptAt  DateTime?
  lastStatusCode Int?
  lastError      String?               @db.Text

  createdAt DateTime @default(now())

  @@index([webhookEndpointId, status])
  /// The 7-day retention purge (docs/08: "retained 7 days").
  @@index([tenantId, createdAt])
  @@index([eventId])
}

/// One row per refresh token. Rotating a token revokes its row and links the
/// replacement; presenting a revoked token again revokes the whole family.
model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Shared by every rotation that descends from one login.
  familyId      String    @db.Uuid
  /// HMAC-SHA256 of the refresh token. The raw token only ever exists in the cookie.
  tokenHash     String    @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  replacedById  String?   @unique @db.Uuid
  ip            String?
  userAgent     String?   @db.Text
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

// ─────────────────────────────────────────────────────────────
//  Core entities
// ─────────────────────────────────────────────────────────────

model Envelope {
  id       String         @id @default(uuid(7)) @db.Uuid
  tenantId String         @db.Uuid
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  title    String
  status   EnvelopeStatus @default(DRAFT)

  ownerId String @db.Uuid
  owner   User   @relation("EnvelopeOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  // Storage. These hold object-storage keys, not public URLs; downloads are
  // streamed or presigned on demand. The original is NEVER mutated.
  originalFileUrl  String
  completedFileUrl String?
  /// Uploaded filename, for display only. Never used as a storage key (docs/10).
  originalFilename String
  pageCount        Int

  // Convenience copies of DocumentVersion 0 and the final version's hashes.
  // DocumentVersion remains the authoritative chain of custody.
  originalHash String
  finalHash    String?

  // Routing
  sequentialSigning Boolean   @default(false)
  /// When the envelope left DRAFT. Null for a draft.
  sentAt            DateTime?
  expiresAt         DateTime?
  completedAt       DateTime?
  /// When the expiry sweep paused it. Kept after an extension, as history.
  expiredAt         DateTime?

  // Cancelling (docs/16 step 4). The reason is shown to the people who were
  // emailed and to the sender; it stays out of the audit metadata.
  voidedAt       DateTime?
  voidReason     String?   @db.Text
  voidedByUserId String?   @db.Uuid
  voidedBy       User?     @relation("EnvelopeVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict)

  /// When the envelope became DECLINED. Lets Needs-attention find recent
  /// declines without aggregating Recipient (100M-row scale follow-up, docs/16).
  declinedAt DateTime?

  /// Automatic reminders every this many days (1–30). Null is off.
  reminderIntervalDays Int?

  /// Optional note included in the invitation email (docs/08, POST /send).
  message String? @db.Text

  /// Bumped by every draft edit. The builder sends the value it loaded back as
  /// `If-Match`, so two tabs editing one draft cannot silently overwrite each
  /// other; a stale value is answered with 412 DRAFT_REVISION_MISMATCH.
  draftRevision Int @default(0)

  // Jurisdiction policy resolution (docs/07, ADR 0011). jurisdictionCode is the
  // resolved code (the envelope's own override, or the tenant's default at
  // creation time); policySnapshot is the full frozen JurisdictionPolicy, so a
  // later edit to the reference policies never changes what an
  // already-signed envelope claims to have complied with. Both are set once,
  // at creation, and never change afterwards.
  jurisdictionCode String @default("US")
  policySnapshot   Json?
  policyVersion    Int?
  /// What kind of document this is, checked at creation against the frozen
  /// policy's blockedDocumentCategories (docs/07).
  documentCategory String @default("OTHER")

  // Legal hold and retention (docs/17 step 7-8). A hold overrides every sweep
  // until released; both placing and releasing one are audit events.
  legalHoldAt       DateTime?
  legalHoldReason   String?   @db.Text
  legalHoldByUserId String?   @db.Uuid
  legalHoldBy       User?     @relation("EnvelopeLegalHoldBy", fields: [legalHoldByUserId], references: [id], onDelete: Restrict)
  /// Set once the sweeper has removed this envelope's (unlocked) storage
  /// objects. The audit trail and the envelope row itself are never deleted.
  /// When it is due is computed at read time from status, timestamps and the
  /// frozen policy's retentionYears (retention.service.ts), rather than kept
  /// in a column that a draft edit or an extension would need to remember to
  /// update.
  purgedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients Recipient[]
  fields     DocumentField[]
  versions   DocumentVersion[]
  auditLogs  AuditTrail[]
  downloads  CompletionDownload[]

  /// The All tab: newest first, with the id tiebreak the cursor compares on.
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  /// Every other status tab, same cursor shape.
  @@index([tenantId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([ownerId])
  /// The expiry sweep: open envelopes past their deadline.
  @@index([status, expiresAt])
}

model Recipient {
  id         String   @id @default(uuid(7)) @db.Uuid
  envelopeId String   @db.Uuid
  envelope   Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  name         String
  email        String
  role         RecipientRole   @default(SIGNER)
  status       RecipientStatus @default(PENDING)
  routingOrder Int             @default(1) // equal values sign in parallel

  /// Which colour this person gets in the field builder. Assigned when they are
  /// added and never reused, so removing someone does not recolour the rest.
  colorIndex Int @default(0)

  // Access credentials. Only the HMAC-SHA256 hash is stored; the raw token exists
  // solely in the email that was sent (docs/10, ADR 0009).
  //
  // Both are null until the email worker mints a token, which it does when it
  // sends the invitation. Every reminder mints a new one and overwrites these,
  // so only the newest link works. Postgres allows many nulls in a unique index.
  tokenHash      String?   @unique
  tokenExpiresAt DateTime?
  tokenUsedAt    DateTime? // single-use enforcement
  accessCode     String? // optional SMS OTP, hashed

  // Progress, shown to the sender.
  /// When this person's turn began: at send, or when the group before them finished.
  invitedAt           DateTime?
  /// When the mail server last accepted an invitation or reminder for them.
  notifiedAt          DateTime?
  /// When the sender last asked for a reminder. Limits reminders to one a day.
  lastRemindedAt      DateTime?
  /// The "expires soon" email went out for the current deadline. Cleared by an extension.
  expiryWarnedAt      DateTime?
  /// When they last asked the sender for more time. Limits it to once a day.
  moreTimeRequestedAt DateTime?
  /// Last time a signing page was read, written at most every 10 minutes. No
  /// automatic reminder goes out while they have the document open.
  lastSeenAt          DateTime?
  /// First time they opened the signing link.
  viewedAt            DateTime?
  /// The document version last served to them. RECIPIENT_SIGNED records it,
  /// with its hash, as the version they attested to (ADR 0003).
  servedVersionNumber Int?

  // Consent (ESIGN, docs/07). The verbatim disclosure text is stored, not a
  // reference to a template that may later change.
  consentGivenAt DateTime?
  consentText    String?   @db.Text

  // The signature and initials this person adopted, as object-storage keys to
  // transparent PNGs. Submitting copies them into every SIGNATURE and INITIALS
  // field they own.
  signatureImageKey String?
  signatureMethod   SignatureMethod?
  initialsImageKey  String?
  initialsMethod    SignatureMethod?

  signedAt       DateTime?
  declinedAt     DateTime?
  declinedReason String?   @db.Text

  // Signing telemetry
  signedFromIp String?
  signedFromUa String? @db.Text

  createdAt DateTime @default(now())

  fields      DocumentField[]
  auditEvents AuditTrail[]
  versions    DocumentVersion[]
  downloads   CompletionDownload[]

  /// Lets DocumentField carry a composite foreign key on (recipientId, envelopeId),
  /// which is what stops a field pointing at a recipient of another envelope
  /// (docs/05, invariant 4).
  @@unique([id, envelopeId])
  /// One entry per person per envelope. Emails are stored lower-cased.
  @@unique([envelopeId, email])
  @@index([envelopeId, routingOrder])
}

model DocumentField {
  id         String   @id @default(uuid(7)) @db.Uuid
  envelopeId String   @db.Uuid
  envelope   Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  // Composite foreign key, not just recipientId: it is the database, rather than
  // the application, that guarantees a field's recipient belongs to the same
  // envelope as the field (docs/05, invariant 4).
  recipientId String    @db.Uuid
  recipient   Recipient @relation(fields: [recipientId, envelopeId], references: [id, envelopeId], onDelete: Cascade)

  type       FieldType @default(SIGNATURE)
  pageNumber Int // 1-indexed
  required   Boolean   @default(true)

  // Normalised coordinates, range [0.0, 1.0]. NEVER pixels, NEVER PDF points.
  // Conversion mathematics: docs/06.
  ratioX      Float
  ratioY      Float
  ratioWidth  Float
  ratioHeight Float

  // Text for TEXT_INPUT / DATE_SIGNED; object-storage key for SIGNATURE / INITIALS.
  value       String?   @db.Text
  isCompleted Boolean   @default(false)
  completedAt DateTime?

  @@index([envelopeId, pageNumber])
  @@index([recipientId])
}

// ─────────────────────────────────────────────────────────────
//  DocumentVersion: chain of custody
//
//  One row per signing round. Version 0 is the original upload.
//  Each later version is the document as the NEXT signer saw it.
// ─────────────────────────────────────────────────────────────

model DocumentVersion {
  id         String   @id @default(uuid(7)) @db.Uuid
  envelopeId String   @db.Uuid
  envelope   Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  versionNumber Int // 0 = original
  fileUrl       String // object-storage key
  hash          String // SHA-256 (hex) of this exact file
  pageCount     Int
  sizeBytes     Int

  // Null for version 0; otherwise the recipient whose signature produced this version.
  createdByRecipientId String?    @db.Uuid
  createdByRecipient   Recipient? @relation(fields: [createdByRecipientId], references: [id], onDelete: SetNull)

  isFinal Boolean @default(false) // certificate appended, Object Lock applied

  /// The storage version id of the sealed file (final version only). The locked
  /// bucket is versioned, so a later write or a delete to the same key would add
  /// a newer version or a delete marker; reads name this id, so what is served
  /// is always exactly the file that was locked (ADR 0007).
  storageVersionId String?
  createdAt        DateTime @default(now())

  @@unique([envelopeId, versionNumber])
  /// Verify looks a file up by its fingerprint, across every tenant (docs/15 step 7).
  @@index([hash])
  @@index([createdByRecipientId])
}

/// A private link to the finished document, emailed instead of an attachment
/// when the file is too large to attach (docs/15 step 6). The token is minted by
/// the email worker; only its HMAC is stored, like a signing link (ADR 0009).
model CompletionDownload {
  id         String   @id @default(uuid(7)) @db.Uuid
  envelopeId String   @db.Uuid
  envelope   Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  /// Who the link was emailed to. Null: the sender, who is not a recipient.
  recipientId String?    @db.Uuid
  recipient   Recipient? @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  tokenHash        String    @unique
  expiresAt        DateTime
  downloadCount    Int       @default(0)
  lastDownloadedAt DateTime?
  /// When this link was last renewed with a fresh token (docs/17 step 10).
  /// Limits renewal to once per DOWNLOAD_RENEW_COOLDOWN_HOURS.
  lastRenewedAt    DateTime?
  createdAt        DateTime  @default(now())

  @@index([envelopeId])
  @@index([recipientId])
}

// ─────────────────────────────────────────────────────────────
//  AuditTrail: append-only, hash-chained
//
//  No UPDATE. No DELETE. Enforced by database privileges (see the
//  initial migration), not by application convention.
// ─────────────────────────────────────────────────────────────

model AuditTrail {
  id         String   @id @default(uuid(7)) @db.Uuid
  envelopeId String   @db.Uuid
  envelope   Envelope @relation(fields: [envelopeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  recipientId String?    @db.Uuid
  recipient   Recipient? @relation(fields: [recipientId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Actor for sender-side events (null for signer and system events).
  actorUserId String? @db.Uuid

  action    String // ENVELOPE_CREATED, ENVELOPE_SENT, CONSENT_GIVEN, ...
  ipAddress String
  userAgent String @db.Text
  metadata  Json?

  // Tamper-evident chain. `sequence` numbers an envelope's events 1, 2, 3, ... so the
  // chain order never depends on timestamps that can collide.
  sequence  Int
  prevHash  String? // previous event's eventHash; null for the first event
  eventHash String  @unique // SHA-256 over (prevHash + action + timestamp + payload)

  timestamp DateTime @default(now())

  @@unique([envelopeId, sequence])
  @@index([recipientId])
}
