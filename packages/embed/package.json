{
  "name": "@envelope/embed",
  "version": "0.10.0",
  "private": true,
  "description": "Envelope embedded sender editor launcher",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/envelope.mjs",
      "default": "./dist/envelope.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@envelope/shared": "workspace:*",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "main": "./dist/envelope.mjs",
  "types": "./dist/index.d.ts"
}
