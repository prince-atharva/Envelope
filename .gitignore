# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo
apps/api/src/generated/

# Environment — real secrets (Gmail App Password, JWT secrets) live only here.
.env
.env.*
!.env.example

# Logs — application logs are operational data, never committed.
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Emails written by MAIL_TRANSPORT=file. They hold live signing links.
.mail-outbox/

# Tests
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Editors / OS
.DS_Store
.idea/
*.swp

# Personal AI-agent settings (the shared ones, .claude/skills and .claude/agents, are committed)
.claude/settings.local.json

# pdf.js font/cmap/wasm files, copied from node_modules by apps/web/scripts/copy-pdfjs-assets.mjs
apps/web/public/pdfjs/
apps/web/e2e/.auth-state.json

# The isolated browser-test stack (apps/web/e2e/stack): its build, logs and outbox.
apps/web/.e2e/
apps/api/.e2e-dist/
apps/api/.audit-check-dist/
