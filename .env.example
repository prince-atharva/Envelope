# ────────────────────────────────────────────────────────────────────
# Envelope by HealthProHub: environment variables
#
#   cp .env.example .env      then fill in the Gmail and secret values
#
# .env is gitignored. Never commit real secrets. Every other value below
# matches docker-compose.yml for local development.
# ────────────────────────────────────────────────────────────────────

NODE_ENV=development
APP_NAME="Envelope by HealthProHub"
# Public URL of the web app. Used for links inside emails.
APP_URL=http://localhost:5173
API_PORT=4000
WEB_PORT=5173
# Where the development web server listens. Localhost by default. To try the
# signing portal from a phone on the same network, set WEB_HOST=0.0.0.0 and
# APP_URL=http://<this computer's LAN address>:5173, so email links reach it.
# WEB_HOST=0.0.0.0
# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:5173
# Which proxies to trust for the client IP (Express "trust proxy"): loopback, true, 1, ...
TRUST_PROXY=loopback
# Swagger UI at /api/docs. Defaults to on, except in production.
# API_DOCS_ENABLED=true

# ── Logging ─────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
# Human-readable console output. Defaults to on in development; JSON otherwise.
# LOG_PRETTY=true
# Daily-rotated JSON log files: logs/api.<date>.<n>.log, logs/api-error.<date>.<n>.log,
# logs/worker.<date>.<n>.log, logs/worker-error.<date>.<n>.log
LOG_FILES_ENABLED=true
# Relative to the repository root.
LOG_DIR=logs
# How many rotated files to keep per log.
LOG_RETENTION_DAYS=14

# ── PostgreSQL ──────────────────────────────────────────────────────
# The app runs as the restricted role: it cannot UPDATE or DELETE audit rows.
DATABASE_URL=postgresql://digitalsign_app:digitalsign_app_dev_password@localhost:5545/digitalsign?schema=public
# Migrations run as the schema owner.
DIRECT_DATABASE_URL=postgresql://digitalsign:digitalsign_dev_password@localhost:5545/digitalsign?schema=public
# Prisma's scratch database. It is RESET whenever `prisma migrate dev` or the CI
# migration drift check runs, so it must hold nothing else. docker-compose
# creates it; on an older volume, create it once with:
#   docker compose exec postgres psql -U digitalsign -d digitalsign \
#     -c 'CREATE DATABASE digitalsign_shadow OWNER digitalsign'
SHADOW_DATABASE_URL=postgresql://digitalsign:digitalsign_dev_password@localhost:5545/digitalsign_shadow?schema=public
# Queries slower than this are logged as warnings.
DB_SLOW_QUERY_MS=500

# ── Redis (BullMQ job queue) ────────────────────────────────────────
REDIS_URL=redis://localhost:6391
# Namespace for queue keys in Redis.
QUEUE_PREFIX=digitalsign

# ── Auth ────────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string
REFRESH_TOKEN_TTL_DAYS=30

# ── Signing links ───────────────────────────────────────────────────
# HMAC key for the tokens in signing links (ADR 0009). Must differ from the two
# secrets above. Changing it makes every link already emailed stop working.
SIGNING_TOKEN_SECRET=replace-with-a-third-long-random-string
# How long a signing link lasts when the sender does not choose (1-90 days).
SIGNING_DEFAULT_EXPIRY_DAYS=14

# ── Object storage (MinIO locally, Cloudflare R2 / AWS S3 in production) ──
S3_ENDPOINT=http://localhost:9102
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=digitalsign
S3_SECRET_ACCESS_KEY=digitalsign_dev_password
S3_BUCKET=digitalsign-documents
S3_FORCE_PATH_STYLE=true
# Sealed, finished documents go to a separate bucket created with Object Lock
# (ADR 0007). Defaults to "<S3_BUCKET>-sealed". GOVERNANCE lets an administrator
# delete a locked file in development; production requires COMPLIANCE.
# S3_SEALED_BUCKET=digitalsign-documents-sealed
# SEALED_RETENTION_MODE=GOVERNANCE
# SEALED_RETENTION_DAYS=2557

# ── Email (Gmail SMTP) ──────────────────────────────────────────────
# smtp: send for real.
# file: send nothing; write each email as JSON to MAIL_OUTBOX_DIR, where you can
#       open it and follow the signing link.
# memory: keep messages in memory (API tests only).
# Automated tests never read this file and never use smtp: they run on their own
# test database with memory or file email (see apps/web/e2e/stack).
MAIL_TRANSPORT=smtp
MAIL_OUTBOX_DIR=.mail-outbox
# A failed email is retried 4 times: after 10s, 20s, 40s and 80s.
EMAIL_RETRY_BASE_DELAY_MS=10000
# The finished document is attached to the completion email up to this size
# (15 MB). A larger file is sent as a private download link instead, valid for
# COMPLETION_LINK_DAYS.
# COMPLETION_ATTACHMENT_MAX_BYTES=15728640
# COMPLETION_LINK_DAYS=30

# ─── Maintenance (worker) ───
# Scheduled jobs: the expiry sweep pauses envelopes past their deadline
# (docs/16). Every worker may register them; they run once per tick.
# MAINTENANCE_SCHEDULES_ENABLED=true
# EXPIRY_SWEEP_EVERY_MS=300000
# Automatic reminders: the interval for envelopes sent without choosing (0 = off
# unless the sender turns them on), the "expires soon" email's lead time, and how
# often the reminder job runs.
# AUTO_REMINDER_DEFAULT_DAYS=3
# EXPIRY_WARNING_HOURS=48
# REMINDER_SWEEP_EVERY_MS=900000

# ─── Alerts ───
# Urgent problems (an audit write or chain failure, a seal or email job that
# failed its last attempt, a sealed file that does not match its fingerprint)
# are always logged with alert: true. Set ALERT_EMAIL to have them emailed
# too, through the SMTP settings above, at most once per problem every
# ALERT_EMAIL_MIN_INTERVAL_MINUTES.
# ALERT_EMAIL=you@example.com
# ALERT_EMAIL_MIN_INTERVAL_MINUTES=15
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# false = STARTTLS on port 587 (Gmail's recommended setting)
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
# A Gmail App Password (Google Account > Security > 2-Step Verification >
# App passwords). Your normal Gmail password will not work.
SMTP_PASSWORD=your-16-character-app-password
# Gmail only allows your own address or a verified alias here.
SMTP_FROM="Envelope by HealthProHub <your-address@gmail.com>"
